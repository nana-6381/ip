<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>

<fx:root type="javafx.scene.layout.HBox" xmlns:fx="http://javafx.com/fxml/1"
         xmlns="http://javafx.com/javafx/17"
         alignment="TOP_RIGHT" spacing="5">
    <Label fx:id="text" wrapText="true"/>
    <ImageView fx:id="displayPicture" fitHeight="75" fitWidth="75" pickOnBounds="true" preserveRatio="true"/>
</fx:root>